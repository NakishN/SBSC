     "type": "any",
     "regex": "(?i)(fly|flight|glide|jetpack|hover)"
    }
   ],
   "any": [
    {
     "type": "any",
     "regex": "(?i)\\b(fly|flight|glide|jetpack)\\b"
    }
   ]
  },
  {
   "id": "behavior_velocity",
   "name": "Отмена отбрасывания",
   "category": "movement",
   "severity": 4,
   "weight": 11,
   "description": "Обнуление/изменение velocity или knockback.",
   "all": [
