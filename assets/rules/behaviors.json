{
 "version": 1,
 "rules": [
  {
   "id": "behavior_hitbox_expand",
   "name": "Расширение хитбоксов",
   "category": "combat",
   "severity": 5,
   "weight": 16,
   "description": "Код увеличивает bounding box сущностей (expand/grow/inflate) в связке с combat-логикой.",
   "all": [
    {
     "type": "ref",
     "regex": "(?i)(getEntityBoundingBox|getBoundingBox|AxisAlignedBB|net/minecraft/util/math/Box|class_238)"
    },
    {
     "type": "ref",
     "regex": "(?i)(expand|grow|inflate|stretch|offset)"
    },
    {
     "type": "any",
     "regex": "(?i)(hitbox|reach|combat|aura)"
    }
   ],
   "any": [
    {
     "type": "any",
     "regex": "(?i)\\b(hitbox|reach|aura|killaura)\\b"
    }
   ]
  },
  {
   "id": "behavior_reach_attack",
   "name": "Увеличенная дистанция атаки",
   "category": "combat",
   "severity": 5,
   "weight": 14,
   "description": "Проверка дистанции до цели и вызов атаки вне ванильных ограничений.",
   "all": [
    {
     "type": "ref",
     "regex": "(?i)(attackEntity|attackTarget|PlayerController|InteractionManager|class_636|class_310)"
    },
    {
     "type": "ref",
     "regex": "(?i)(getDistance|distanceTo|distanceSq|canEntityBeSeen|rayTrace|raycast)"
    },
    {
     "type": "any",
     "regex": "(?i)(reach|range|aura|combat|killaura)"
    }
   ],
   "any": [
    {
     "type": "any",
     "regex": "(?i)\\b(reach|range|aura|combat|killaura)\\b"
    }
   ]
  },
  {
   "id": "behavior_rotation_aim",
   "name": "Автоповорот / aim-логика",
   "category": "combat",
   "severity": 5,
   "weight": 12,
   "description": "Принудительная установка yaw/pitch и расчёт углов до цели.",
   "all": [
    {
     "type": "ref",
     "regex": "(?i)(setYaw|setPitch|wrapDegrees|lookAt|class_3532)"
    },
    {
     "type": "any",
     "regex": "(?i)(aim|aura|rotation|combat|killaura|silent)"
    }
   ],
   "any": [
    {
     "type": "any",
     "regex": "(?i)\\b(aim|aura|combat|killaura|silent)\\b"
    }
   ]
  },
  {
   "id": "behavior_attack_loop",
   "name": "Цикл авто-атаки",
   "category": "combat",
   "severity": 5,
   "weight": 12,
   "description": "Вызов атаки/свинга в связке с настройками CPS или задержки удара.",
   "all": [
    {
     "type": "ref",
     "regex": "(?i)(attackEntity|swingHand|sendPacket|C03PacketPlayer|class_2884)"
    },
    {
     "type": "string",
     "regex": "(?i)(cps|clicks.?per.?second|autoclicker|triggerbot|attack.?delay)"
    }
   ]
  },
  {
   "id": "behavior_esp_render",
   "name": "ESP / рендер сквозь стены",
   "category": "render",
   "severity": 4,
   "weight": 8,
   "description": "Рендер боксов/линий через RenderSystem, BufferBuilder или WorldRenderEvents.",
   "all": [
    {
     "type": "ref",
     "regex": "(?i)(RenderSystem|BufferBuilder|Tessellator|WorldRenderEvents|drawBox|drawOutline|GL11|GlStateManager|class_4587|class_287)"
    },
    {
     "type": "any",
     "regex": "(?i)(esp|tracer|chams|wallhack|render|outline)"
    }
   ],
   "any": [
    {
     "type": "any",
     "regex": "(?i)\\b(esp|tracer|chams|wallhack)\\b"
    }
   ]
  },
  {
   "id": "behavior_xray",
   "name": "X-Ray логика",
   "category": "render",
   "severity": 4,
   "weight": 13,
   "description": "Перехват отрисовки блоков и проверка непрозрачности в связке с X-Ray/поиском блоков.",
   "all": [
    {
     "type": "ref",
     "regex": "(?i)(BlockState|getBlockState|isOpaque|shouldDrawSide|getBlock|class_2680|class_1922)"
    },
    {
     "type": "any",
     "regex": "(?i)(xray|x-ray|blockesp|search|opaque)"
    }
   ],
   "any": [
    {
     "type": "any",
     "regex": "(?i)\\b(xray|x-ray|blockesp)\\b"
    }
   ]
  },
  {
   "id": "behavior_fly",
   "name": "Fly / изменение движения",
   "category": "movement",
   "severity": 5,
   "weight": 12,
   "description": "Прямое изменение motionY/velocity/capabilities в связке с полётом.",
   "all": [
