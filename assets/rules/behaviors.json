     "regex": "(?i)\\b(velocity|antiknockback|knockback)\\b"
    }
   ]
  },
  {
   "id": "behavior_scaffold",
   "name": "Scaffold / авто-мост",
   "category": "world",
   "severity": 5,
   "weight": 12,
   "description": "Автоматическая установка блоков под игроком.",
   "all": [
    {
     "type": "ref",
     "regex": "(?i)(placeBlock|BlockPlacement|BlockPos|getBlockState|interactBlock|class_3966|class_2338)"
