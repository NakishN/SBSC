  {
   "id": "behavior_nuker",
   "name": "Nuker / массовое разрушение",
   "category": "world",
   "severity": 5,
   "weight": 12,
   "description": "Массовое разрушение блоков через blockAction/clickBlock.",
   "all": [
    {
     "type": "ref",
     "regex": "(?i)(blockAction|onPlayerDamageBlock|clickBlock|destroyBlock|breakBlock|class_636|class_2885)"
    },
    {
     "type": "any",
     "regex": "(?i)(nuker|excavator|veinminer|autofarm)"
    }
   ]
  },
  {
   "id": "behavior_disabler",
   "name": "Disabler / AC scan",
   "category": "misc",
   "severity": 5,
   "weight": 14,
   "description": "Упоминание AC вместе с логикой обхода/флагов.",
   "all": [
    {
     "type": "any",
     "regex": "(?i)\\b(Verus|Intave|Grim|Matrix|Polar|Vulcan|Spartan|NoCheatPlus|NCP|AAC|Watchdog|Hypixel)\\b"
    },
    {
     "type": "any",
     "regex": "(?i)\\b(disabler|bypass|flag|exploit|antidetect)\\b"
    }
   ]
  },
  {
   "id": "behavior_packet_exploit",
   "name": "Пакетный эксплойт",
   "category": "exploit",
   "severity": 5,
   "weight": 10,
   "description": "Ссылки на пакеты, используемые в эксплойтах (ClickWindow, ConfirmTransaction, PacketFly и т.п.).",
   "any": [
    {
     "type": "string",
     "regex": "(?i)(C0EPacketClickWindow|C0FPacketConfirmTransaction|C00PacketKeepAlive|C03PacketPlayer|C04PacketPlayerPosition|PacketFly|ServerCrasher|ForceOp|class_2881|class_2883)"
    }
   ],
   "all": [
    {
     "type": "ref",
     "regex": "(?i)(Packet|sendPacket|C0[0-9]|C1[0-9]|C2[0-9]|C3[0-9])"
    },
    {
     "type": "string",
     "regex": "(?i)(C0EPacketClickWindow|C0FPacketConfirmTransaction|C00PacketKeepAlive|C03PacketPlayer|C04PacketPlayerPosition|PacketFly|ServerCrasher|ForceOp|class_2881|class_2883)"
    }
   ]
  },
  {
   "id": "behavior_mixin_combat",
   "name": "Mixin в combat-классы Minecraft",
   "category": "combat",
   "severity": 4,
   "weight": 8,
   "description": "Mixin-инъекции в Minecraft/ClientPlayerEntity/PlayerController в методах атаки/тиков.",
   "all": [
    {
     "type": "any",
     "regex": "(?i)(Mixin|CallbackInfo|Inject|Redirect|Overwrite)"
    },
    {
     "type": "any",
     "regex": "(?i)(MinecraftClient|net/minecraft/client/Minecraft|ClientPlayerEntity|ClientPlayerInteractionManager|PlayerController|class_310|class_746|class_636)"
    },
    {
     "type": "any",
     "regex": "(?i)(attack|sendMovement|rotation|look)"
    },
    {
     "type": "any",
     "regex": "(?i)\\b(combat|aura|reach|hitbox|killaura|aim)\\b"
    }
   ]
  },
  {
   "id": "behavior_reflection_loader",
   "name": "Динамическая загрузка классов",
   "category": "obfuscation",
   "severity": 4,
   "weight": 9,
   "description": "Class.forName/defineClass/URLClassLoader в связке с cheat/hack/inject/payload.",
   "all": [
    {
     "type": "ref",
     "regex": "(?i)(Class\\.forName|defineClass|URLClassLoader)"
    },
    {
     "type": "any",
     "regex": "(?i)(cheat|hack|inject|payload)"
    }
   ]
  },
  {
   "id": "behavior_native_load",
   "name": "Загрузка нативной библиотеки",
   "category": "native",
   "severity": 4,
   "weight": 10,
   "description": "System.load/loadLibrary и встроенная DLL/SO в jar.",
   "all": [
    {
     "type": "ref",
     "regex": "(?i)(System\\.load|loadLibrary|Runtime.*load|native)"
    },
    {
     "type": "path",
     "regex": "(?i)\\.(dll|so|dylib)$"
    }
   ]
  },
  {
   "id": "behavior_aim_snap",
